# ---------------------------------------------------------------------------
# Vinted AI Photo Enhancer — configuration (copy to .env)
# Every value has a safe development default unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
SECRET_KEY=change-me-to-a-long-random-string-of-64-chars-minimum   # REQUIRED: replace (see INSTALL.md)
PUBLIC_APP_URL=http://localhost:3000    # used for CORS/Origin checks and Stripe redirects
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # addresses allowed to call the API
COOKIE_SECURE=false                     # true behind HTTPS
ADMIN_EMAILS=admin@example.com          # comma-separated; these accounts get the admin dashboard
BRAND_NAME=Vinted AI                    # product name shown in the UI (NEXT_PUBLIC_BRAND_NAME)

# --- Database --------------------------------------------------------------
# Without Docker the API uses SQLite (apps/api/var/dev.db) and creates the tables itself.
# docker compose sets its own PostgreSQL URL. For your own PostgreSQL, uncomment:
# DATABASE_URL=postgresql+psycopg://vai:vai@localhost:5432/vai
# AUTO_CREATE_SCHEMA=false              # then run: alembic upgrade head

# --- Storage (private, signed URLs) ----------------------------------------
STORAGE_BACKEND=local                   # local | s3 (AWS S3, Cloudflare R2, MinIO)
LOCAL_STORAGE_PATH=./var/storage
S3_BUCKET=vinted-ai
S3_ENDPOINT_URL=                        # e.g. https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=                 # host used in presigned URLs if different (MinIO in Docker)
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256        # empty for R2 (always encrypted at rest)
SIGNED_URL_TTL_SECONDS=3600

# --- Queue -----------------------------------------------------------------
JOB_BACKEND=inline                      # inline (thread pool) | celery (Redis) | sync (tests)
REDIS_URL=redis://localhost:6379/0
INLINE_WORKERS=2
WORKER_CONCURRENCY=4                    # Celery worker processes (docker compose)

# --- Product limits & credits ----------------------------------------------
MAX_UPLOAD_MB=25
MAX_PHOTOS_PER_UPLOAD=12
GUEST_CREDITS=3
CREDIT_COST_ENHANCE=1
# Plans are seeded from configuration then editable live in the admin dashboard.

# --- Privacy / GDPR --------------------------------------------------------
DEFAULT_RETENTION_DAYS=30
GUEST_RETENTION_DAYS=2
MAX_RETENTION_DAYS=365

# --- Billing (optional) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={}                     # {"starter":"price_...","pro":"price_...","business":"price_..."}

# --- AI providers (optional; the local engine needs none) --------------------
AI_ROUTING={}                           # {"segmentation":"rembg","clothing_detection":"anthropic","defect_detection":"anthropic"}
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REPLICATE_API_TOKEN=
REPLICATE_UPSCALE_VERSION=              # Real-ESRGAN model version id (generative: blocked in "Préserver l'article")
REMBG_MODEL=isnet-general-use

# --- MinIO (docker compose) --------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret-key
